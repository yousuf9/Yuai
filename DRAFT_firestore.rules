rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidDataset(data) {
      return data.keys().hasAll([
          'ownerId',
          'name',
          'sheetName',
          'rowCount',
          'columnCount',
          'columnsSummary',
          'trendsSummary',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'name',
          'sheetName',
          'rowCount',
          'columnCount',
          'columnsSummary',
          'trendsSummary',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.sheetName is string && data.sheetName.size() >= 1 && data.sheetName.size() <= 100
        && data.rowCount is int && data.rowCount >= 0 && data.rowCount <= 10000000
        && data.columnCount is int && data.columnCount >= 0 && data.columnCount <= 10000
        && data.columnsSummary is string && data.columnsSummary.size() >= 1 && data.columnsSummary.size() <= 15000
        && data.trendsSummary is string && data.trendsSummary.size() <= 15000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQueryLog(data, datasetId) {
      return data.keys().hasAll([
          'datasetId',
          'ownerId',
          'question',
          'answer',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'datasetId',
          'ownerId',
          'question',
          'answer',
          'createdAt'
        ])
        && data.datasetId is string && data.datasetId.size() >= 1 && data.datasetId.size() <= 128 && data.datasetId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.datasetId == datasetId
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.question is string && data.question.size() >= 1 && data.question.size() <= 2000
        && data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 20000
        && data.createdAt is timestamp;
    }

    match /datasets/{datasetId} {
      allow get: if isSignedIn() && isValidId(datasetId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(datasetId)
        && isValidDataset(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidDataset(incoming())
        && isValidId(datasetId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['trendsSummary', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'trendsSummary', 'updatedAt'])
        );
      allow delete: if isSignedIn() && isValidId(datasetId) && existing().ownerId == request.auth.uid;

      match /queries/{queryId} {
        allow get: if isSignedIn()
          && isValidId(datasetId)
          && isValidId(queryId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/datasets/$(datasetId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create: if isSignedIn()
          && isValidId(datasetId)
          && isValidId(queryId)
          && isValidQueryLog(incoming(), datasetId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/datasets/$(datasetId))
          && get(/databases/$(database)/documents/datasets/$(datasetId)).data.ownerId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn()
          && isValidId(datasetId)
          && isValidId(queryId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/datasets/$(datasetId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
